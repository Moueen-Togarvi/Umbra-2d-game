<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts: the wordmark on near-black. The
         game is dark whatever the system theme, so day and night match. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- Behind the Flutter UI once it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/umbra_black</item>
    </style>
</resources>
