<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the wordmark on the brand's near-black, shown while
     the engine starts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/umbra_black" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_wordmark" />
    </item>
</layer-list>
