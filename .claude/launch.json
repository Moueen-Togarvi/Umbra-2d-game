{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "umbra-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8765",
        "--web-hostname",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "umbra-web-release",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "build/web"
      ],
      "port": 8790
    }
  ]
}